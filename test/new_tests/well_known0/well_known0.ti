
def (f x)
  ;; Because all the call sites for loop are known statically (i.e. loop is well-known),
  ;; loop will be lifted to the top level and passed x (without any closure allocation)
	def (loop i)
  {
		(debug_print "i=" + (write i) + " with x=" + (write x))
    if i <= 0
       0
       (loop (- i 1))
  }

	(loop 5)

def (main)
  (f 5)