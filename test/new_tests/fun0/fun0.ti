;; a standard Tinkr function declared at top-level scope
def (tinkr_add a b) 
  a + b

;; A blessed function is an already compiled low-level IR function
;; _raw__identity is an encoded name we can ref from outside as raw_identity
blessed (_raw__identity _fb x)
{
  ;; Manually writing a blessed-IR function that is callable
  ;; from tinkr and usable as a value is possible w/ an idiom. E.g.,
 
  ;; CPS for:  return x
  kfun = (stack_pop)
  return (kfun 0 x)
}

def (main)
  ;; We may store global function pointers in local variables
  let f1 = tinkr_add ;; tinkr_add is usable immediately as a value
  let f2 = raw_identity ;; note the decoded name

  let res1 = (f1 10 20)
  let res2 = (f2 99)
  let res3 = (raw_identity 250) ;; same behavior as if referenced directly
  
  ;; Output should be [30 99 250]
  (debug_print (write [res1 res2 res3]))