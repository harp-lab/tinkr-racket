
def (get_x `[vec ,x ,y])
  x

def (get_y `[vec ,x ,y])
  y

def `[vec ,x1 ,y1] + `[vec ,x2 ,y2]
  `[vec ,(+ x1 x2) ,(+ y1 y2)]

def (slice_to_vec [x y])
  `[vec ,x ,y]
def (slice_to_vec [xs ...])
  `[vec 101 101] ;; error

;; div
def `[vec ,x ,y] / s when s = 0
  `[vec 101 101] ;; error
def `[vec ,x ,y] / s
  `[vec ,(/ x s) ,(/ y s)]

def (main)
  let v1 `[vec 1 2]
  let v2 (slice_to_vec [3 0])
  let v3 v1 + v2
  let v4 v3 / 0
  let a = (+ (get_x v4) (get_y v4))
  let b (get_x (/ v3 2))
  (debug_print (write a));
  (debug_print (write b))



