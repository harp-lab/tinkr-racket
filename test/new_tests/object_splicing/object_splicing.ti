
def (to_slice `[line ,all ...])
  [all ...]
def (to_slice `[some ,all ...])
  [all ...]

def (swap `[line ,x1 ,y1 ,end ...])
  `[line ,end ... ,x1 ,y1] ;; Spreading/splicing with objects

def (main)
{
  (debug_print (write (to_slice `[line 5 6 7 8])))
  (debug_print (write (to_slice (swap `[line 5 6 7 8]))))
  let a [1 2 3 4 5 6 7 8]
  let b [9]
  let c [12 13]
  let d []
  let e `[some ,d ... 0 ,a ... ,b ... 10 11 ,c ... 14 15 16 ,d ... 17]
  (debug_print (write (to_slice e)))
}