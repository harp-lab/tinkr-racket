
;; Nested list ellipsis
def (nested x [y0 y1] ...)
  y0 + y1

;; Nested ellipsis patterns
def (map f [] ...) []
def (map f [xs lsts ...] ...)
  [(f xs ...) (map f lsts ...) ...]

def (add x y)
  x + y

def (main)
{
  (debug_print (write (nested 5 [5 6] [7 8])))
  (debug_print (write (map add [1 2 3 4] [1 2 3 4])))
}