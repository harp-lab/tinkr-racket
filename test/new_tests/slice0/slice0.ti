
def (main)
{
  (debug_print "is_empty:")
  (debug_print (write (is_empty [])))
  (debug_print (write (is_empty [1])))
  (debug_print (write (is_empty [5 6 7 8])))
  (debug_print (write (is_empty [[]])))

  let a []
  let b [1 2 3]
  {
    (debug_print (write (is_empty a)))
    (debug_print (write (is_empty b)))
    
    (debug_print "Concatenation (+):")
    (debug_print (write a))
    (debug_print (write (+ a b)))
    (debug_print (write (+ b a)))
    (debug_print (write (+ b b)))
    (debug_print (write (+ a a)))

    (debug_print "is_slice:")
    (debug_print (write (is_slice [])))
    (debug_print (write (is_slice [5 6 7 8])))
    (debug_print (write (is_slice a)))
    (debug_print (write (is_slice b)))
    (debug_print (write (is_slice `[set])))
    (debug_print (write (is_slice 123)))
    (debug_print (write (is_slice "123")))
  }
}