
def (indirect_call f arg)
  (f arg)

def (main)
  let is_even_base_case0 0
  let is_even_base_case1 1

  ;; Mututal recursion with both one well-known and the other not well-known
  def (is_even x)
    if (= x is_even_base_case0) true
    if (= x is_even_base_case1) false
    (is_odd (- x 1))
  def (is_odd x)
    if (= x 0) false
    if (= x 1) true
    (is_even (- x 1))

  {
    (debug_print (write (is_even 0)))
    (debug_print (write (is_odd 0)))
    (debug_print (write (is_even 1)))
    (debug_print (write (is_odd 1)))
    (debug_print (write (is_even 2)))
    (debug_print (write (is_odd 2)))
    (debug_print (write (is_even 40)))
    (debug_print (write (is_odd 40)))
    (debug_print (write (is_even 43)))
    (debug_print (write (is_odd 43)))
    (debug_print (write (indirect_call is_odd 43)))
  }