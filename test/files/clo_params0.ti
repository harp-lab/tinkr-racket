
def (main)
  ;; 5 params
  def (f5 a b c d e) 
    e + d + c + b + a

  ;; 6 params
  def (f6 a b c d e g) 
    g + e + d + c + b + a

  ;; 7 params
  def (f7 a b c d e g h) 
    h + g + e + d + c + b + a

  ;; 8 params
  def (f8 a b c d e g h i) 
    i + h + g + e + d + c + b + a

  let s5 = [1 2 3 4 5]
  let s6 = [1 2 3 4 5 6]
  let s7 = [1 2 3 4 5 6 7]
  let s8 = [1 2 3 4 5 6 7 8]
  (debug_print (write (f5 1 2 3 4 5)));
  (debug_print (write (f6 1 2 3 4 5 6)));
  (debug_print (write (f7 1 2 3 4 5 6 7)));
  (debug_print (write (f8 1 2 3 4 5 6 7 8)));
  (debug_print (write (f5 s5 ...)));
  (debug_print (write (f6 s6 ...)));
  (debug_print (write (f7 s7 ...)));
  (debug_print (write (f8 s8 ...)))



