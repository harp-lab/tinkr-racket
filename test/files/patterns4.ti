
let empty_set = `[set]

def (slice_to_set []) empty_set
def (slice_to_set [xs ...])
  `[set ,xs ...]

def (set_to_slice ,empty_set) []
def (set_to_slice `[set ,xs ...])
  [xs ...]

def (in_slice [] elm) false
def (in_slice [x xs ...] elm)
  if x = elm
    true
    (in_slice xs elm)

def (in_set ,empty_set elm) false
def (in_set `[set ,xs ...] elm)
  (in_slice xs elm)

;; Dispatch error if we use ,empty_set instead of `[set]
def (set_union ,empty_set ,empty_set) `[set]
def (set_union ,empty_set x=`[set ,xs ...]) x
;;def (set_union `[set] (& x `[set ,xs ...])) x
def (set_union x=`[set ,xs ...] ,empty_set) x
def (set_union x=`[set ,xs ...] `[set ,y_elm ,ys ...])
  if (in_set x y_elm)
    (set_union x `[set ,ys ...])
    (set_union `[set ,xs ... ,y_elm] `[set ,ys ...])



def (main)
{
  let a (slice_to_set [1 2 3 4])
  let b (slice_to_set [2 4 6 8])
  let c (set_union a b)
  let d (slice_to_set [])
  {
    (debug_print (write (set_to_slice a)))
    (debug_print (write (set_to_slice b)))
    (debug_print (write (set_to_slice c)))
    (debug_print (write (set_to_slice d)))

    (debug_print (write (set_to_slice (set_union a d))))
    (debug_print (write (set_to_slice (set_union d a))))
    (debug_print (write (set_to_slice (set_union d d))))

    (debug_print (write (set_to_slice (set_union c d))))
    (debug_print (write (set_to_slice (set_union d c))))
    (debug_print (write (set_to_slice (set_union d d))))
  }
}