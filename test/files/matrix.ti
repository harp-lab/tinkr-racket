
;;def (make_mat `[[,xs ...] ...])
;;  `[mat ,xs ...]

def (is_mat `[mat [,(? xs int) ...] ...]) true
def (is_mat x) false

def (write `[mat [,xs ...] ...])
  (write xs)

def (main)
{
  let I `[mat ,[1 0]
              ,[0 1]]
  {
    (debug_print (write (is_mat [1 2 3])))
    (debug_print (write (is_mat I)))
    (debug_print (write I))
  }
}