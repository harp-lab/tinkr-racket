
def (write `[set])
  "set"

def (test3 [(& xs `[set]) ...])
  xs
def (test3 xs ...)
  false

def (test4 [(& lsts [(& xs `[set]) ...]) ...])
{
  (debug_print (write lsts))
  xs
}
def (test4 xs ...)
  false

def (test5 `[outer ,(& xs `[set]) ...])
  xs
def (test5 xs ...)
  false

def (test6 [[(? xs int) ...] ...])
  xs
def (test6 xs ...)
  false

def (map [f [] ...]) []
def (map [f [xs lsts ...] ...])
  [(f xs ...) (map [f lsts ...]) ...]


def (add1 x)
  (+ x 1)

def (add x y)
  (+ x y)

def (main)
{
  (debug_print "Test 3:")
  (debug_print (write (test3 `[set])))
  (debug_print (write (test3 [])))
  (debug_print (write (test3 [`[set] `[set] `[set]])))
  (debug_print (write (test3 [`[set] 2 3])))

  (debug_print "Test 4:")
  (debug_print (write (test4 [[`[set] `[set] `[set]]
                              [`[set] `[set] `[set]]
                              [`[set] `[set] `[set]]])))
  (debug_print (write (test4 [[`[set] `[set] `[set]]
                              [`[set] `[set] 1]
                              [`[set] `[set] `[set]]])))
  (debug_print (write (test4 [`[set]])))

  (debug_print "Test 5:")
  (debug_print (write (test5 `[set])))
  (debug_print (write (test5 `[outer `[set]])))
  (debug_print (write (test5 `[outer `[set] `[set] `[set]])))
  (debug_print (write (test5 `[outer `[set] 2 3])))

  (debug_print "Test 6:")
  (debug_print (write (test6 1)))
  (debug_print (write (test6 [[1 2 3]
                              [4 5 6]])))
  (debug_print (write (test6 [[1 2 3]
                              [4 false 6]])))

  (debug_print "Map:")
  (debug_print (write (map [add1 []])))
  (debug_print (write (map [add1 [1 2 3 4]])))
  (debug_print (write (map [add [1 2 3 4] [4 3 2 1]])))
}
