
def (test1 x x x y z)
  [x y z]
def (test1 xs ...)
  false

def (test2 x [x x x ys ...] ...)
  [x] + ys
def (test2 xs ...)
  false

def (main)
{
  ;; These do not produce the correct results

  (debug_print "Test 1:")
  (debug_print (write (test1 1 1 1 2 3)))
  (debug_print (write (test1 1 2 1 2 3))) ;; Should produce false

  (debug_print "Test 2:")
  (debug_print (write (test2 1 [1 1 1 2 3 4] [1 1 1 5 6 7])))
  (debug_print (write (test2 1 [1 1 1 2 3 4] [1 2 1 5 6 7]))) ;; Should produce false
}