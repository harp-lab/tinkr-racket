
def `[vec] + (& v `[vec ,a ...]) v
def (& v `[vec ,a ...]) + `[vec] v
def `[vec ,(? a int) ...] + `[vec ,(? b int) ...] ;; ? doesn't work yet
  [,a ... ,b ...]

;;def (write `[vec ,xs ...]) 
;;  "`[vec" + (foldl (lambda (acc x) (+ acc " " (write x))) "" xs) + "]"

def (to_slice `[vec ,xs ...])
  xs

def (main)
{
  (debug_print (write (to_slice `[vec 1 2] + `[vec])))
  (debug_print (write (to_slice `[vec] + `[vec 1 2])))
  (debug_print (write `[vec 1 2] + `[vec 3 4 5]))
}