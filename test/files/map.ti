
def (map f []) []
def (map f [x xs ...])
  [(f x) (map f xs) ...]

;; Nested patterns like this don't work
;;def (multi_map f [] ...) []
;;def (multi_map f [xs lsts ...] ...)
;;  [(f xs ...) (multi_map f lsts ...) ...]

def (add1 x)
  x + 1

def (add x y)
  x + y

def (main)
{
  (debug_print (write (map add1 [1 2 3 4])))
  ;;(debug_print (write (multi_map add [1 2 3 4] [1 2 3 4])))
}
