
def (foldl f acc [] ...) acc
def (foldl f acc [xs lsts ...] ...)
  (foldl f (f xs ... acc) lsts ...)

def (map f [] ...) []
def (map f [xs lsts ...] ...)
  [(f xs ...) (map f lsts ...) ...]

def (flatten (? lst is_slice))
  def (f (? lst is_slice))
    (foldl (lambda (x acc) (+ acc (f x))) [] lst)
  def (f x) [x]

  (f lst)
def (flatten x) x

def (max x) x
def (max x y)
  if (> x y) x y
def (max x y rest ...)
  (max (max x y) rest ...)

def (add x y)
  x + y

def (add1 x)
  x + 1

def (main)
{
  (debug_print (write (foldl add 0 [1 2 3 4 5])))
  (debug_print (write (map add1 [1 2 3 4])))
}