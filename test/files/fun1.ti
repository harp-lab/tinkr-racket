



;; A higher-order function that takes a function pointer 'op'
def (apply_op op a b)
  (op a b)

def (mul x y)
  x * y

def (sub x y)
  x - y

def (main)
  ;; Pass the 'mul' and 'sub' function pointers as arguments
  let ans1 = (apply_op mul 10 5)
  let ans2 = (apply_op sub 10 5)

  ;; Output should be [50 5]
  (debug_print (write [ans1 ans2]))



