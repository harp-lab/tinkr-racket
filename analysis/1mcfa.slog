table (program expr)

table (src expr str int int int int)

union (expr (bound_var str)
  (free_var str)
  (num_lit int)
  (str_lit str)
  (sym_lit str)
  (true_lit)
  (false_lit)
  (eq_prim)
  (num_prim str)
  (cmp_prim str)
  (str_prim str)
  (slice [expr])
  (object str [expr])
  (lam [str] expr)
  (app expr [expr])
  (if expr expr expr)
  (let str expr expr)
  (def str [str] expr expr)
  (begin expr expr)
  (notmodeled str))

union (call_ctx (seed) (out_of_reach) app)
union (heap_ctx seed out_of_reach app)
union (val
  (closure lam call_ctx)
  (alloc expr heap_ctx)
  num_lit
  str_lit
  sym_lit
  true_lit
  false_lit
  eq_prim
  num_prim
  cmp_prim
  str_prim
  (abs_num call_ctx)
  (abs_str call_ctx)
  (idk))

table (store str call_ctx val)
table (heap expr heap_ctx int val)
table (heap_from expr heap_ctx int [val])
table (has_escaped val)
table (has_escapeds [val])
table (bind_params_to [str] [val] call_ctx)
table (bind_params_to_idk [str] call_ctx)
table (live_branch expr call_ctx expr)

demand (eval expr call_ctx) val
demand (evals [expr] call_ctx) [val]
demand (apply val [val] call_ctx) val
demand (freevar expr) str
demand (freevars [expr]) str

rule (freevar (bound_var x) x)
rule (freevar (app ef es) x) <-- (freevar ef x) | (freevars es x)
rule (freevar (slice es) x) <-- (freevars es x)
rule (freevar (object tag es) x) <-- (freevars es x)
rule (freevar (if ec et ee) x) <-- (freevar ec x) | (freevar et x) | (freevar ee x)
rule (freevar (begin ea eb) x) <-- (freevar ea x) | (freevar eb x)
rule (freevar (lam xs eb) x) <-- (freevar eb x) (= 0 (lmem xs x))
rule (freevar (let y er eb) x) <-- ((freevar er x) | (freevar eb x)) (/= x y)
rule (freevar (def f xs eb er) x) <-- (freevar eb x) (= 0 (lmem xs x)) (/= x f)
rule (freevar (def f xs eb er) x) <-- (freevar er x) (/= x f)
rule (freevars [e es ...] x) <-- (freevar e x) | (freevars es x)

rule (eval (num_lit n) c (num_lit n))
rule (eval (str_lit s) c (str_lit s))
rule (eval (sym_lit s) c (sym_lit s))
rule (eval (true_lit) c (true_lit))
rule (eval (false_lit) c (false_lit))
rule (eval (eq_prim) c (eq_prim))
rule (eval (num_prim op) c (num_prim op))
rule (eval (cmp_prim op) c (cmp_prim op))
rule (eval (str_prim op) c (str_prim op))
rule (eval (free_var x) c (idk))
rule (eval (notmodeled what) c (idk))
rule (eval (lam xs eb) c (closure (lam xs eb) c))
rule (eval (bound_var x) c v) <-- (store x c v)

rule (evals [] c [])
rule (evals [e es ...] c [(eval e c) (evals es c) ...])

rule (eval (slice es) c (alloc (slice es) c)) <-- (evals es c vs)
rule (eval (object tag es) c (alloc (object tag es) c)) <-- (evals es c vs)

rule (heap_from (slice es) c 0 vs) <-- (eval (slice es) c) (evals es c vs)
rule (heap_from (object tag es) c 0 vs) <-- (eval (object tag es) c) (evals es c vs)
rule (heap site hc i v) (heap_from site hc (+ i 1) vs) <-- (heap_from site hc i [v vs ...])

rule (eval (app ef es) c v) <-- (eval ef c f) (evals es c vs) (apply f vs (app ef es) v)

rule (apply (closure (lam xs eb) cb) vs c2 v) <-- (eval eb c2 v)
rule (bind_params_to xs vs c2) <-- (apply (closure (lam xs eb) cb) vs c2)
rule (store y c2 vy) <-- (apply (closure (lam xs eb) cb) vs c2) (freevar (lam xs eb) y) (store y cb vy)
rule (apply (idk) vs c2 (idk))
rule (apply (eq_prim) [v v] c2 (true_lit)) <-- (= v (num_lit _)) | (= v (str_lit _)) | (= v (sym_lit _)) | (= v (true_lit)) | (= v (false_lit))
rule (apply (eq_prim) [va vb] c2 (false_lit)) <-- (/= va vb)
  ((= va (num_lit _))
    | (= va (str_lit _))
    | (= va (sym_lit _))
    | (= va (true_lit))
    | (= va (false_lit)))
  ((= vb (num_lit _))
    | (= vb (str_lit _))
    | (= vb (sym_lit _))
    | (= vb (true_lit))
    | (= vb (false_lit)))

rule (apply (eq_prim) [va vb] c2 (idk)) <-- (= va (idk)) | (= va (closure _ _)) | (= va (alloc _ _)) | (= va (eq_prim))
rule (apply (eq_prim) [va vb] c2 (idk)) <-- (= vb (idk)) | (= vb (closure _ _)) | (= vb (alloc _ _)) | (= vb (eq_prim))
rule (apply (eq_prim) [va vb] c2 (true_lit)) <-- (= va (abs_num _)) | (= vb (abs_num _)) | (= va (abs_str _)) | (= vb (abs_str _))
rule (apply (eq_prim) [va vb] c2 (false_lit)) <-- (= va (abs_num _)) | (= vb (abs_num _)) | (= va (abs_str _)) | (= vb (abs_str _))

rule (apply (num_prim op) vs c2 (abs_num c2))
rule (apply (str_prim op) vs c2 (abs_str c2))

rule (apply (cmp_prim "<") [(num_lit a) (num_lit b)] c2 (true_lit)) <-- (< a b)
rule (apply (cmp_prim "<") [(num_lit a) (num_lit b)] c2 (false_lit)) <-- (>= a b)
rule (apply (cmp_prim "<=") [(num_lit a) (num_lit b)] c2 (true_lit)) <-- (<= a b)
rule (apply (cmp_prim "<=") [(num_lit a) (num_lit b)] c2 (false_lit)) <-- (> a b)
rule (apply (cmp_prim ">") [(num_lit a) (num_lit b)] c2 (true_lit)) <-- (> a b)
rule (apply (cmp_prim ">") [(num_lit a) (num_lit b)] c2 (false_lit)) <-- (<= a b)
rule (apply (cmp_prim ">=") [(num_lit a) (num_lit b)] c2 (true_lit)) <-- (>= a b)
rule (apply (cmp_prim ">=") [(num_lit a) (num_lit b)] c2 (false_lit)) <-- (< a b)
rule (apply (cmp_prim op) [va vb] c2 (true_lit)) <-- (= va (abs_num _)) | (= vb (abs_num _))
rule (apply (cmp_prim op) [va vb] c2 (false_lit)) <-- (= va (abs_num _)) | (= vb (abs_num _))
rule (apply (cmp_prim op) [va vb] c2 (idk)) <-- (= va (idk)) | (= vb (idk))

rule (has_escapeds vs) <-- (apply (idk) vs c2)
rule (apply (alloc site hc) vs c2 (idk))
rule (has_escapeds vs) (has_escaped (alloc site hc)) <-- (apply (alloc site hc) vs c2)

rule (store x c v) (bind_params_to xs vs c) <-- (bind_params_to [x xs ...] [v vs ...] c)
rule (has_escaped v) (bind_params_to [] vs c) <-- (bind_params_to [] [v vs ...] c)
rule (store x c (idk)) (bind_params_to_idk xs c) <-- (bind_params_to_idk [x xs ...] c)

rule (has_escaped v) (has_escapeds vs) <-- (has_escapeds [v vs ...])
rule (has_escaped v) <-- (has_escaped (alloc site hc)) (heap site hc i v)
rule (bind_params_to_idk xs (out_of_reach)) (eval eb (out_of_reach)) <-- (has_escaped (closure (lam xs eb) cb))
rule (store y (out_of_reach) vy) <-- (has_escaped (closure (lam xs eb) cb)) (freevar (lam xs eb) y) (store y cb vy)
rule (has_escaped v) <-- (has_escaped (closure (lam xs eb) cb)) (eval eb (out_of_reach) v)

rule (live_branch (if ec et ee) c ee) <-- (eval (if ec et ee) c) (eval ec c (false_lit))
rule (live_branch (if ec et ee) c et) <-- (eval (if ec et ee) c) (eval ec c vc) (/= vc (false_lit)) (/= vc (idk))
rule (live_branch (if ec et ee) c et) (live_branch (if ec et ee) c ee) <-- (eval (if ec et ee) c) (eval ec c (idk))
rule (eval (if ec et ee) c v) <-- (live_branch (if ec et ee) c eb) (eval eb c v)

rule (eval (let x er eb) c v) <-- (eval er c vr) (eval eb c v)
rule (store x c vr) <-- (eval (let x er eb) c) (eval er c vr)

rule (eval (def f xs eb er) c v) <-- (eval er c v)
rule (store f c (closure (lam xs eb) c)) <-- (eval (def f xs eb er) c)

rule (eval (begin ea eb) c v) <-- (eval ea c va) (eval eb c v)


table (program_result val)
table (callee expr call_ctx expr)
table (idk_callee expr)
table (several_callees expr)
table (always_calls expr expr)

rule (eval e (seed)) <-- (program e)
rule (program_result v) <-- (program e) (eval e (seed) v)

rule (callee (app ef es) c (lam xs eb)) <-- (eval (app ef es) c) (eval ef c (closure (lam xs eb) cb))
rule (idk_callee (app ef es)) <-- (eval (app ef es) c) (eval ef c (idk))
rule (idk_callee (app ef es)) <-- (eval (app ef es) c) (eval ef c (alloc site hc))
rule (several_callees call) <-- (callee call c1 lm1) (callee call c2 lm2) (/= lm1 lm2)
rule (always_calls call lm) <-- (callee call c lm) ~(several_callees call) ~(idk_callee call)
