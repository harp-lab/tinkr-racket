
def (g x y z)
  (+ x y z)

def (f x y)
  def (g z)
    (+ x y z)
  def (g z a)
    (+ x y z a)
  
  {
    (debug_print (write (g 3)))     ;; 6
    (debug_print (write (g 3 4)))   ;; 10
    (debug_print (write (g 3 4 5))) ;; 12
  }

def (main)
  (f 1 2)

;; ----- Desugar ----->

def (g fallback arg-count x y z)
  if (= arg-count 3)
    (+ x y z)
    ;; fail

def (f fallback arg-count x y)
  def (g1 fallback arg-count z)
    let g g1
      if (= arg-count 1)
        (+ x y z)
        (fail g2)
  def (g2 fallback arg-count z a)
    let g g1
      if (= arg-count 2)
        (+ x y z a)
        (fail g3)
  def (g3 fallback arg-count args_rest ...)
    (_apply none 2 g args_rest) ;; NOTE: the _apply here is not the same as the apply in closure conversion (I need to think of a better way to differentiate the two)
  
  let g g1

  {
    (debug_print none 1 (write none 1 (g none 1 3)))
    (debug_print none 1 (write none 1 (g none 2 3 4)))
    (debug_print none 1 (write none 1 (g none 3 3 4 5)))
  }

