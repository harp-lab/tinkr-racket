;; ----- Limit def params ----->

def (g fallback arg-count x y z pad1 pad2 pad3)
  if (= arg-count 3)
    ;; (+ x y z)
    ;; fail

def (apply1 fallback arg-count clo z pad1 pad2 pad3 pad4)
  ;; unpack clo
    if (= arg-count 1)
      ;; (+ x y z)
      (g2 fallback arg-count clo z pad1 pad2 pad3 pad4)

def (g2 fallback arg-count clo z a pad1 pad2 pad3)
  ;; unpack clo
    if (= arg-count 2)
      ;; (+ x y z a)
      (g3 fallback arg-count clo z a pad1 pad2 pad3)

def (g3 fallback arg-count clo args_rest_gather1 args_rest_gather2 args_rest_gather3 args_rest_gather4 args_rest_rest)
  ;; This introduces an inefficiency because of the gathering followed directly by ungathering (i.e. _apply), but otherwise it should work
  let args_rest (gather fallback 6 args_rest_gather1 args_rest_gather2 args_rest_gather3 args_rest_gather4 _noarg [args_rest_rest])
    (_apply none 2 g args_rest)

def (f fallback arg-count x y pad1 pad2 pad3 pad4)
  ;; let g1 `[clo1 ,g ,g2 ,x ,y]
  
  {
    (debug_print none 1 (write none 1 (apply none 1 g1 3)))
    (debug_print none 1 (write none 1 (apply none 2 g1 3 4)))
    (debug_print none 1 (write none 1 (apply none 3 g1 3 4 5)))
  }

def (apply_fun_ptr fallback arg-count func args_gather1 args_gather2 args_gather3 args_gather4 args_rest)
  let args (gather fallback 6 args_gather1 args_gather2 args_gather3 args_gather4 _noarg [args_rest])
    (_apply none 2 func args)

