;; ----- Closure convert ----->

def (g fallback arg-count x y z)
  if (= arg-count 3)
    ;; (+ x y z)
    ;; fail

def (apply1 fallback arg-count clo z)
  ;; unpack clo
    if (= arg-count 1)
      ;; (+ x y z)
      (fail g2)

def (g2 fallback arg-count clo z a)
  ;; unpack clo
    if (= arg-count 2)
      ;; (+ x y z a)
      (fail g3)

def (g3 fallback arg-count clo args_rest ...)
  (_apply none 2 g args_rest)

def (f fallback arg-count x y)
  let g1 `[clo1 ,g ,g2 ,x ,y] ;; desugar this statement

  ;; if g1 is recursive then will need to create a recursive closure (similarly if we have mutually recursive inner-defs)
  
  {
    (debug_print none 1 (write none 1 (apply none 1 g1 3)))
    (debug_print none 1 (write none 1 (apply none 2 g1 3 4)))
    (debug_print none 1 (write none 1 (apply none 3 g1 3 4 5)))
  }

def (apply_fun_ptr fallback arg-count func args ...)
  ;; In order to prevent this from going into an infinite loop (since _apply will currently make a call to apply_fun_ptr once compiled), I will need
  ;; to either create a blessed version of _apply (which assumes that func must be a function ptr and not a closure) or I will need to
  ;; just inline the body code of _apply here directly. 
  (_apply none 2 func args)

