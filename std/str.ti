


include "clang.ti"

bless ("#include <iostream>")



def (is_str `[str ,len_hash ,cstr]) true
def (is_str x) false


def (_init_from_cstr _ cstr)
  `[str ,(bless (str_len_hash cstr 0 0))
	,cstr]


def (size `[str ,len_hash ,cstr])
  (_init_from_s64 none (bless (car_u32 len_hash)))


def `[str ,len_hash0 ,cstr0] + `[str ,len_hash1 ,cstr1]
  let len0 = (bless (car_u32 len_hash0))
  let len1 = (bless (car_u32 len_hash1))
  let s = (bless (cstr_concat2 cstr0 len0 cstr1 len1))
    (_init_from_cstr none s)


def (debug_print `[str ,len_hash ,cstr])
  let _ = (bless (cstr_println cstr))
    none


def (write s=`[str ,len_hash ,cstr])
  s


def (= `[str ,len_hash0 ,cstr0] `[str ,len_hash1 ,cstr1])
  if (bless (equal len_hash0 len_hash1))
     (bless (cstr_equal cstr0 cstr1))
     false

blessed (cstr_equal cstr0 cstr1) (equal (call_2 "strcmp" (cstr_t cstr0) (cstr_t cstr1)) 0)

blessed (cstr_println s)
{
  do ("std::cout << $0 << std::endl" (cstr_t s))
  return 0
}

blessed (cstr_print s)
{
  do ("std::cout << $0" (cstr_t s))
  return 0
}


blessed (str_inner_step cp byte type state)
  (cond (neq state 0)
	(bit_or (bit_and byte "0x3f") (lshift cp 6))
	(bit_and (rshift "0xff" type) byte))

blessed (str_step_one s)
{
  byte0 = (u64_t (u8_t (deref (cstr_t s))))
  type0 = (u64_t (indexat utf8dfa (u32_t byte0)))
  cp0 = (str_inner_step 0 byte0 type0 0)
  state0 = (u64_t (indexat utf8dfa (u64plus 256 (u64plus type0 (u64times 0 16)))))

  if (eq state0 0) return (cons_u32 cp0 1)
  { }

  byte1 = (u64_t (u8_t (deref (cstr_t (u64plus s 1)))))
  type1 = (u64_t (indexat utf8dfa (u32_t byte1)))
  cp1 = (str_inner_step cp0 byte1 type1 state0)
  state1 = (u64_t (indexat utf8dfa (u64plus 256 (u64plus type1 (u64times state0 16)))))

  if (eq state1 0) return (cons_u32 cp1 2)
  { }
  
  byte2 = (u64_t (u8_t (deref (cstr_t (u64plus s 2)))))
  type2 = (u64_t (indexat utf8dfa (u32_t byte2)))
  cp2 = (str_inner_step cp1 byte2 type2 state1)
  state2 = (u64_t (indexat utf8dfa (u64plus 256 (u64plus type2 (u64times state1 16)))))

  if (eq state2 0) return (cons_u32 cp2 3)
  { }

  byte3 = (u64_t (u8_t (deref (cstr_t (u64plus s 3)))))
  type3 = (u64_t (indexat utf8dfa (u32_t byte3)))
  cp3 = (str_inner_step cp2 byte3 type3 state2)
  state3 = (u64_t (indexat utf8dfa (u64plus 256 (u64plus type3 (u64times state2 16)))))

  if (eq state3 0) return (cons_u32 cp3 4)
  { }

  do (fatal "\"Bad UTF-8 encoded string.\"")
  return 0
}

;; CStr u64 u64 -> u64
;; Returns the length of s (most significant 32 bits) and a hash
;; of s (least significant 32 bits). len and h should be initalized
;; to zero on first call.
blessed (str_len_hash s len h)
{
  ;; If it is any empty string then just return len_hash=1 (so the len=0 and hash=1)
  ;; We can't just use C's 0 since otherwise it will cause problems elsewhere since C's 0 is treated specially).
  if (eq (deref (cstr_t s)) 0) return 1 { }
  
  p0 = (str_step_one s)
  s0 = (u64plus (cdr_u32 p0) s)
  cp = (car_u32 p0)
  h0 = (bit_xor (rotl (u32_t h) 3) (u32_t cp))
  len0 = (u64plus len 1)
  
  if (eq (deref (cstr_t s0)) 0)
    ;; Set the least significant bit to 0 in order for the len_hash not to be treated as a special value.
    ;; Untagged values can cause bugs elsewhere, for example, with object/slice delimiters or the empty object value.
    return (u64bit_and (cons_u32 len0 h0) "0xfffffffffffffffe")
    return (str_len_hash s0 len0 h0)
}

blessed (cstr_concat2 a an b bn)
{
   anbn = (u64plus an bn)
   !s = (alloc_bytes (u64plus anbn 1))
   do (assign (indexat (cstr_t s) anbn) 0)
   do (memcpy s a an)
   do (memcpy (u64plus s an) b bn)
   return s
}

blessed (cstr_concat3 a an b bn c cn) ;; TODO: unused?
{
   anbn = (u64plus an bn)
   anbncn = (u64plus anbn cn)
   !s = (alloc_bytes (u64plus anbncn 1))
   do (assign (indexat (cstr_t s) anbncn) 0)
   do (memcpy s a an)
   do (memcpy (u64plus s an) b bn)
   do (memcpy (u64plus s anbn) c cn)
   return s
}








bless
("


