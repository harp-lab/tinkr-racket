
def (foldl f acc [] ...) acc
def (foldl f acc [xs lsts ...] ...)
  (foldl f (f xs ... acc) lsts ...)

def (map f [] ...) []
def (map f [xs lsts ...] ...)
  [(f xs ...) (map f lsts ...) ...]

def (filter f []) []
def (filter f [x rest ...])
  if (f x)
     [x (filter f rest) ...]
     (filter f rest)

def (flatten (? lst is_slice))
  def (f (? lst is_slice))
    (foldl (lambda (x acc) (+ acc (f x))) [] lst)
  def (f x) [x]

  (f lst)
def (flatten x) x

def (max x) x
def (max x y)
  if (> x y) x y
def (max x y rest ...)
  (max (max x y) rest ...)

def (min x) x
def (min x y)
  if (< x y) x y
def (min x y rest ...)
  (min (min x y) rest ...)

