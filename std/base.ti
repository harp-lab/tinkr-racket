

include "debug.ti"

include "clang.ti"
include "stack.ti"


include "str.ti"
include "int.ti"
include "seq.ti"
include "slice.ti"
include "bool.ti"
include "begin.ti"
include "lib.ti"


include "main.ti"






let none = `[none]
let _noarg = `[_noarg]

;; A compiler internal value that indicates when a pattern match has failed (returned from an inner loop).
let _fail = `[_fail]

def x = y false


;; Boxing and tagging subword values

blessed (box_subword value tag)
  (u64bit_or (u64lshift value 8)
	     (bit_or (plus 6 (u64rshift tag 5))
		     (lshift (u64bit_and 31 tag) 3)))

blessed (unbox_subword x) (u64rshift x 8)

blessed (get_subword_tag x)
  (plus (rshift (u64bit_and 255 x) 3)
	(times 32 (minus (u64bit_and 7 x) 6)))





;; Object head-word and slices

blessed (obj_head_word len vtbl)
  (bit_or (bit_or (u64lshift len 48) 255)
  	  (lshift (bottom32 vtbl) 8))

blessed (lookup_object_tag x) 
  (u64bit_or (bottom32 (u64rshift (deref (manys_t (top61 x))) 8))
	     (top32 (blessed_t _main)))

blessed (get_object_tag x) 
  (cond (eq 1 (u64bit_and x 7))
	(lookup_object_tag x)
	(u64minus 0 1))

blessed (get_object_slice x)
  ;; obj is tagged 001, slices 010
  (cond (bit_or (eq 0 (deref (plus 1 (anys_t (top61 x)))))
                (eq 255 (u64bit_and 255
                                    (deref (plus 1 (anys_t (top61 x)))))))
        _empty
        (u64plus 2 (plus 1 (anys_t (top61 x)))))

;; MutableObject UntaggedInt Slice -> UntaggedInt
;; Initalizes the given object `mut_obj` with the values in `vals`.
;; Returns an updated index.
blessed (init_obj_from_slice mut_obj curr_i vals)
{
  if (eq vals _empty)
  {
    return curr_i
  }
  {
    val = (deref (anys_t (top61 vals)))
    if (u64bit_or (eq 0 val) (eq 255 (u64bit_and 255 val)))
    {
      return curr_i
    }
    {
      do (init_obj mut_obj curr_i val)

      the_rest = (plus (anys_t (top61 vals)) 1)
      new_i = (plus (u64_t curr_i) 1)
      return (init_obj_from_slice mut_obj new_i the_rest)
    }
  }
}


;; (or FunPtr Closure) Slice ->
;; Runtime trampoline for dynamically spliced function calls
def (_apply f args)
  if (= args empty) (f)
  let a0 = (first args)
  let r0 = (rest args)
  if (= r0 empty) (f a0)
  
  let a1 = (first r0)
  let r1 = (rest r0)
  if (= r1 empty) (f a0 a1)
  
  let a2 = (first r1)
  let r2 = (rest r1)
  if (= r2 empty) (f a0 a1 a2)
  
  let a3 = (first r2)
  let r3 = (rest r2)
  if (= r3 empty) (f a0 a1 a2 a3)
  
  ;; Need to call __apply__ since f could be a closure
  ;; Stop at 6 args to __apply__ (plus fallback and arg_count to make 8 total)
  ;; Arg count offest of -1 since __apply__ should only includes f's arguments in it's arg count
  (raw_apply __apply__ (bless (minus 0 1)) f a0 a1 a2 a3 r3)

;; FunPtr CInt Any Any Any Any Any Slice ->
;; Bypasses desugar auto-slicing to invoke a function pointer directly via C++ ABI
;; This blessed function has a special exception in desugar and limit-def-params which
;; allows it to take 8 args.
blessed (_raw__apply f arg_count_offset a0 a1 a2 a3 a4 r4)
{
  r4_ptr = (anys_t (top61 r4))
  r4_length = (_slice_len r4_ptr)
  arg_count = (plus (plus 5 (u64_t r4_length)) (u64_t arg_count_offset))

  ;; We cast 0 to (any)0 to satisfy Clang's strict musttail type-matching rules
  do ("tailcall any_to_blessed($0)(alloc_fr, alloc_bk, stack_fr, (any)0, (any)$1, $2, $3, $4, $5, $6, $7)" f arg_count a0 a1 a2 a3 a4 r4)
  return 0
}

;; FunPtr Slice ->
blessed (_apply_on_slice f arg_count arg0 arg1 arg2 arg3 rest_args)
{
  ;; We cast 0 to (any)0 to satisfy Clang's strict musttail type-matching rules
  if (bl_slice_empty rest_args)
  {
    do ("tailcall any_to_blessed($0)(alloc_fr, alloc_bk, stack_fr, (any)0, $1, $2, $3, $4, $5, $6, $7)" f arg_count arg0 arg1 arg2 arg3 _u__noarg _u__noarg)
    return 0
  }
  {
    a0 = (bl_slice_first rest_args)
    r0 = (bl_slice_rest rest_args)
    if (bl_slice_empty r0)
    {
      do ("tailcall any_to_blessed($0)(alloc_fr, alloc_bk, stack_fr, (any)0, $1, $2, $3, $4, $5, $6, $7)" f arg_count arg0 arg1 arg2 arg3 a0 _u__noarg)
      return 0
    }
    {
      do ("tailcall any_to_blessed($0)(alloc_fr, alloc_bk, stack_fr, (any)0, $1, $2, $3, $4, $5, $6, $7)" f arg_count arg0 arg1 arg2 arg3 a0 r0)
      return 0
    }
  }
}

;; FunPtr FunPtr Slice ->
;; Similar to _apply except it applies f with a fallback
def (_apply_with_fallback f fallback args)
  if (= args empty) (raw_apply_with_fallback f fallback (bless 0))
  let a0 = (first args)
  let r0 = (rest args)
  if (= r0 empty) (raw_apply_with_fallback f fallback (bless 1) a0)
  
  let a1 = (first r0)
  let r1 = (rest r0)
  if (= r1 empty) (raw_apply_with_fallback f fallback (bless 2) a0 a1)
  
  let a2 = (first r1)
  let r2 = (rest r1)
  if (= r2 empty) (raw_apply_with_fallback f fallback (bless 3) a0 a1 a2)
  
  let a3 = (first r2)
  let r3 = (rest r2)
  if (= r3 empty) (raw_apply_with_fallback f fallback (bless 4) a0 a1 a2 a3)
  
  (raw_apply_with_fallback_full f fallback a0 a1 a2 a3 r3)

;; Two helpers (similar to _raw__apply) to apply f with a fallback argument
;; Both of these helpers have special exceptions inside the desugar and limit def params phases
;; to prevent a slice being passed for the last argument.

;; With arg_count and no rest slice
blessed (_raw__apply__with__fallback f fallback arg_count a0 a1 a2 a3)
{
  do ("tailcall any_to_blessed($0)(alloc_fr, alloc_bk, stack_fr, $1, (any)$2, $3, $4, $5, $6, $7, $8)" 
                                                              f fallback arg_count a0 a1 a2 a3 _u__noarg _u__noarg) 
  return 0
}

;; We have a rest slice r3 which must be non-empty
blessed (_raw__apply__with__fallback__full f fallback a0 a1 a2 a3 r3)
{
  r4_ptr = (any_t (plus (anys_t (top61 r3)) 1)) ;; get rest (r4)
  r4_length = (_slice_len r4_ptr)
  r4_slice = (u64bit_or 2 r4_ptr) ;; Retag as a slice

  do ("tailcall any_to_blessed($0)(alloc_fr, alloc_bk, stack_fr, $1, (any)((u64)5 + (u64)$2), $3, $4, $5, $6, $7, (any)$8)" 
                                                              f fallback r4_length a0 a1 a2 a3
                                                              (deref (anys_t (top61 r3))) ;; get first (a4)
                                                              r4_slice) 
  return 0
}


;; Runtime gatherer for dynamically building vararg slices from registers
def (_gather a0 a1 a2 a3 a4 a5)
  let base_slice = 
    if (bless (equal a2 _noarg))
      ;; Length is between 0 and 2
      if (bless (equal a0 _noarg)) empty
      if (bless (equal a1 _noarg)) [a0]
      [a0 a1]
    ;; Length is between 3 and 5
    if (bless (equal a3 _noarg)) [a0 a1 a2]
    if (bless (equal a4 _noarg)) [a0 a1 a2 a3]
    [a0 a1 a2 a3 a4]
  
  ;; Always treat a5 as variadic
  if (bless (equal a5 _noarg))
    base_slice
    (_slice_concat base_slice a5)

;; Vtable lookup and dispatch
blessed (vtable_lookup arg0 pos)
{
  tag = (u64bit_and 7 arg0)

  if (eq tag 0) ;; function pointers (no vtable)
    return (blessed_t fail_locally)
  if (eq tag 1) ;; Normal heap-obj vtable lookup
    return (indexat (_t "blessed_t*" (lookup_object_tag arg0)) pos)
  if (eq tag 2) ;; Slice vtable lookup
    return (indexat _u__slice_vtable pos)
    
  if (eq tag 6) ;; Subword vtable lookup
    return (indexat (indexat subword_tables (get_subword_tag arg0)) pos)
  if (eq tag 7)
    return (indexat (indexat subword_tables (get_subword_tag arg0)) pos)
  
  { 
   do (fatal "\"Unknown tag in vtable_lookup\"")
   return 0
  }
}


blessed (fail_dispatch)
{
  do (fatal "\"Dispatch Failed.\"")
  return 0
}


blessed (fail_locally fallback a0 a1 a2 a3 a4 a5 a6)
{
  fun = (deref (anys_t fallback))
  fb1 = (plus (manys_t fallback) 1)
  return (fun fb1 a0 a1 a2 a3 a4 a5 a6)
}
