

bless
("


// tinkr program exit:
reg_passing AVXRet _main_kont(many m0, many m1, many m2,
                              any a0, any a1, any a2, any a3, 
                              any a4, any a5, any a6, any a7)
{
  // Simply returns
  return AVXRet::a1m3(a1, m0, m1, m2);
} 


// tinkr program entry:
int main(int argc, char** argv)
{
  // Allocate mutable allocation+stack contexts
  many alloc_fr = (many)alignup(
			  (many*)GC_MALLOC(128*sizeof(many)),
			  32);
  many alloc_bk = (many)((many*)alloc_fr + 128);
  many stack_fr = (many)GC_MALLOC(1024*1024*sizeof(many));
  
  ((many*)stack_fr)[0] = (many)(blessed_t)_main_kont;
  stack_fr = (many)(((many*)stack_fr) + 1);

  // Jump into the compiled blessed-code entry point
  auto final_ret = entry_point_init(alloc_fr, alloc_bk, stack_fr,
			            // Otherwise, no arguments
			            0,0, 0,0, 0,0, 0,0);

  // Display the 64bit value returned as the exit code
  // std::cout << (u64)final_ret.a0() << std::endl;  

  return 0;
}


")


